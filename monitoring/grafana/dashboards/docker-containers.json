      "id": 3,
      "title": "Sử dụng RAM theo Container (Memory Usage)",
      "type": "timeseries",
      "targets": [{ "expr": "sum(container_memory_usage_bytes{name=~\".+\"}) by (name)", "legendFormat": "{{name}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
