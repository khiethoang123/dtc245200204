# ==============================================================================
# CẤU HÌNH MYSQL 8.0 SERVER - TỐI ƯU HIỆU NĂNG & BẢO MẬT (HARDENING)
# ==============================================================================
[mysqld]
# Khả năng tương thích xác thực mật khẩu
default_authentication_plugin=mysql_native_password

# Tối ưu hóa bộ nhớ đệm InnoDB cho môi trường container
innodb_buffer_pool_size=256M
innodb_log_file_size=64M
innodb_flush_log_at_trx_commit=2
innodb_flush_method=O_DIRECT

# Giới hạn kết nối phòng chống cạn kiệt tài nguyên (Resource Exhaustion)
max_connections=150
max_connect_errors=20
connect_timeout=10
wait_timeout=600
interactive_timeout=600

# ------------------------------------------------------------------------------
# BẢO MẬT HỆ THỐNG (HARDENING)
# ------------------------------------------------------------------------------
# Vô hiệu hóa tính năng nạp file tùy ý từ client (ngăn chặn Arbitrary File Read)
local_infile=0

# Tắt duyệt symbolic link
skip_symbolic_links=1

# Tiêu chuẩn bộ ký tự UTF-8 hỗ trợ tiếng Việt đầy đủ
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

# Bật chế độ SQL nghiêm ngặt (Strict Mode)
sql_mode=STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION
