# --- CẤU HÌNH MYSQL DATABASE ---
MYSQL_ROOT_PASSWORD=MySQL_Root_P@ssw0rd_Secure_2026!
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wp_user
MYSQL_PASSWORD=WP_Database_P@ssw0rd_2026!
MYSQL_PORT=3306

# User dành riêng cho Prometheus MySQL Exporter (Least Privilege)
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=Exporter_Secure_P@ss_2026!

# --- CẤU HÌNH WORDPRESS ---
WORDPRESS_DB_HOST=mysql:3306
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=WP_Database_P@ssw0rd_2026!
WORDPRESS_DB_NAME=wordpress_db
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=0

# --- CẤU HÌNH NGINX REVERSE PROXY & PORTS ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- CẤU HÌNH PHPMYADMIN ---
PMA_PORT=8080

# --- CẤU HÌNH GIÁM SÁT PROMETHEUS & GRAFANA ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Grafana_Admin_Secured_2026!

# Exporters Ports
CADVISOR_PORT=8081
NODE_EXPORTER_PORT=9100
MYSQL_EXPORTER_PORT=9104
NGINX_EXPORTER_PORT=9113

# --- CẤU HÌNH GHI LOG LOKI & PROMTAIL ---
LOKI_PORT=3100
PROMTAIL_PORT=9080
